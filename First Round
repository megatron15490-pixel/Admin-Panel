function renderRules(){$("ruleCount").textContent=`${rules.length} rules`;$("ruleList").innerHTML=rules.map((r,i)=>`<div class="rule"><div><strong>${esc(r.domain)}</strong><small>${r.action==="blocked"?"Block this domain":"Allow this domain"}</small></div><div style="display:flex;align-items:center;gap:9px"><span class="badge ${r.action}">${r.action==="blocked"?"Blocked":"Allowed"}</span><button class="danger" data-rule-delete="${i}">Remove</button></div></div>`).join("")||`<div class="empty">No custom rules yet. Add one above.</div>`}
