function renderAll(){renderStats();renderDashDevices();renderDashActivity();renderDevices();renderRules();renderLogs();$("bannerToggle").checked=settings.banner;$("recordToggle").checked=settings.record;$("workspaceName").value=settings.name;$("bannerNotice").style.display=settings.banner?"block":"none"}
